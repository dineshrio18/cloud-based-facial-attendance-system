# ==============================================================================
# Cloud-Based Facial Attendance Recognition System - Environment Configuration
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file containing real secrets to source control!
# ==============================================================================

# Application Environment & Mode
# APP_MODE options: 'LOCAL' (standalone SQLite, local face storage, works without AWS)
#                   'CLOUD' (requires configured AWS RDS MySQL and AWS S3)
APP_MODE=LOCAL
APP_ENV=development
FLASK_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
TIMEZONE=Asia/Kolkata

# Local Database Configuration (Used when APP_MODE=LOCAL)
LOCAL_DB_PATH=data/attendance.db

# AWS RDS MySQL Configuration (Used when APP_MODE=CLOUD)
DB_HOST=your-rds-endpoint.c1234567890.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=facial_attendance
DB_USER=admin
DB_PASSWORD=your_rds_password
DB_CONNECT_TIMEOUT=10
# Optional SSL CA certificate for secure RDS connection (e.g., certs/global-bundle.pem)
DB_SSL_CA=

# AWS S3 Cloud Storage Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-facial-attendance-images-bucket
# Leave access keys blank if using AWS CLI named profile or IAM Role
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Facial Recognition & Quality Thresholds
# Euclidean distance threshold (Default: 0.50. Lower is stricter, higher is more forgiving)
RECOGNITION_THRESHOLD=0.50
# Ambiguity margin: difference required between the closest match and the second closest match
AMBIGUITY_MARGIN=0.05
# Cooldown period (in seconds) before the same student can trigger another recognition event
RECOGNITION_COOLDOWN_SECONDS=60
# Number of face samples captured during student registration (recommended 30-50)
FACE_CAPTURE_TARGET_COUNT=35
# Computer vision backend engine: 'auto' (prefers face_recognition, falls back to OpenCV SFace/DNN)
FACE_ENGINE=auto

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
